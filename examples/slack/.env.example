# OAuth & Permissions > Bot User OAuth Token (after installing the app to the workspace)
SLACK_BOT_TOKEN=xoxb-...
# Basic Information > App-Level Tokens, scope connections:write
SLACK_APP_TOKEN=xapp-...
# Slack user IDs allowed to talk to the bot (comma-separated). Everyone else is ignored silently.
SLACK_ALLOWED_USERS=U0123456789
# 1 if you applied manifest-agent-view.yaml, unset for manifest.yaml
SLACK_AGENT_VIEW=1
# Optional. Where pi runs. Defaults to the current directory.
PI_CWD=
