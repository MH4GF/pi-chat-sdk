# chat-sdk's peer set (vitest ^4) trips npm arborist without this. Keep for CI and Dependabot.
legacy-peer-deps=true
# Supply-chain cooldown for `npm install`: ignore versions published less than 7 days ago
# (npm >= 11.10; older npm ignores the key with a warning). Do not bypass with --min-release-age 0.
min-release-age=7
